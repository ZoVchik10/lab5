<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F5F7FA"
    android:layout_width="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="🏠Умный Дом"
        android:textColor="#2C3E50"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline30"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.3" />

    <TextView
        android:id="@+id/tempLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="🌡Teмператypа"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#3498DB"
        app:layout_constraintTop_toTopOf="@id/guideline30"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guideline50" />

    <TextView
        android:id="@+id/tempValue"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:text="22°C"
        android:textSize="48sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#E3F2FD"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/tempLabel"
        app:layout_constraintStart_toStartOf="@id/tempLabel"
        app:layout_constraintEnd_toEndOf="@id/tempLabel"
        android:layout_marginTop="8dp" />


    <TextView
        android:id="@+id/lightLabel"
        android:layout_width="187dp"
        android:layout_height="wrap_content"
        android:text="💡Освещение"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#F39C12"
        app:layout_constraintTop_toTopOf="@id/guideline30"
        app:layout_constraintStart_toEndOf="@id/guideline50"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/lightValue"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:text="75%"
        android:textSize="48sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#FFF3E0"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/lightLabel"
        app:layout_constraintStart_toStartOf="@id/lightLabel"
        app:layout_constraintEnd_toEndOf="@id/lightLabel"
        android:layout_marginTop="8dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline50"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/buttonBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tempValue, lightValue" />

    <TextView
        android:id="@+id/controlLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="🔳Управление"
        android:textColor="#27AE60"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonBarrier" />

    <Button
        android:id="@+id/tempUpButton"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="Tenлee +"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/controlLabel"
        android:backgroundTint="#E74C3C"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tempDownButton"
        app:layout_constraintHorizontal_chainStyle="spread"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp" />
    <Button
        android:id="@+id/tempDownButton"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="Xолоднее -"
        android:textSize="16sp"
        android:backgroundTint="#3498DB"
        app:layout_constraintTop_toTopOf="@id/tempUpButton"
        app:layout_constraintStart_toEndOf="@id/tempUpButton"
        app:layout_constraintEnd_toStartOf="@id/lightonButton"
        android:layout_marginEnd="8dp" />
    <Button
        android:id="@+id/lightonButton"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="Включить"
        android:textSize="16sp"
        android:backgroundTint="#2ECC71"
        app:layout_constraintTop_toTopOf="@id/tempUpButton"
        app:layout_constraintStart_toEndOf="@id/tempDownButton"
        app:layout_constraintEnd_toStartOf="@id/lightoffButton"
        android:layout_marginEnd="8dp" />
    <Button
        android:id="@+id/lightoffButton"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="Выключить"
        android:textSize="16sp"
        android:backgroundTint="#E74C3C"
        app:layout_constraintTop_toTopOf="@id/tempUpButton"
        app:layout_constraintStart_toEndOf="@id/lightonButton"
        app:layout_constraintEnd_toEndOf="parent" />
    <Button
        android:id="@+id/tempUpButn"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="📺ТВ ВКЛ"
        android:textSize="10sp"
        app:layout_constraintTop_toBottomOf="@+id/titleText"
        android:backgroundTint="#E74C3C"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tempDownButton"
        app:layout_constraintHorizontal_chainStyle="spread"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp" />
    <Button
        android:id="@+id/tempDownButt"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="🎵АУДИО ВКЛ "
        android:textSize="10sp"
        android:backgroundTint="#3498DB"
        app:layout_constraintTop_toTopOf="@+id/tempUpButn"
        app:layout_constraintStart_toEndOf="@id/tempUpButton"
        app:layout_constraintEnd_toStartOf="@id/lightonButton"
        android:layout_marginEnd="8dp" />
    <Button
        android:id="@+id/lightonBu"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="💻ПК ВЫКЛ "
        android:textSize="10sp"
        android:backgroundTint="#2ECC71"
        app:layout_constraintTop_toTopOf="@+id/tempUpButn"
        app:layout_constraintStart_toEndOf="@id/tempDownButton"
        app:layout_constraintEnd_toStartOf="@id/lightoffButton"
        android:layout_marginEnd="8dp" />
    <Button
        android:id="@+id/lightoffButto"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="🔌РОЗЕТКА 5/8"
        android:textSize="10sp"
        android:backgroundTint="#E74C3C"
        app:layout_constraintTop_toTopOf="@+id/tempUpButn"
        app:layout_constraintStart_toEndOf="@id/lightonButton"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/securityIndicator"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginTop="32dp"
        android:background="#2C3E50"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tempUpButton" />
    <TextView
        android:id="@+id/securityText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔐Система безопасности"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="@id/securityIndicator"
        app:layout_constraintBottom_toBottomOf="@id/securityIndicator"
        app:layout_constraintStart_toStartOf="@id/securityIndicator"
        app:layout_constraintEnd_toStartOf="@id/securityButton"
        android:gravity="center_vertical"
        android:paddingStart="16dp" />

    <Button
        android:id="@+id/securityButton"
        android:layout_width="120dp"
        android:layout_height="48dp"
        android:backgroundTint="#27AE60"
        android:text="АКТИВНА"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@id/securityIndicator"
        app:layout_constraintEnd_toEndOf="@+id/securityIndicator"
        app:layout_constraintTop_toTopOf="@id/securityIndicator"
        android:layout_marginEnd="16dp"/>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="✅Все системы работают нормально"
        android:textColor="#27AE60"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/securityIndicator" />

</androidx.constraintlayout.widget.ConstraintLayout>




